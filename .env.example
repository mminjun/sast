# 환경변수 템플릿 (DAR-001)
# 사용법:  cp .env.example .env  후 실제 값으로 채운다.
# .env는 .gitignore로 제외된다 — 실제 비밀번호를 이 파일에 적지 말 것.

POSTGRES_DB=sast
POSTGRES_USER=sast
# 예: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-generate-a-random-value
POSTGRES_PORT=5432

# Django 세팅 단계에서 사용할 접속 정보 (호스트에서 접속 시)
# DATABASE_URL=postgres://sast:<password>@127.0.0.1:5432/sast
