# 환경변수 템플릿 (DAR-001)
# 사용법:  cp .env.example .env  후 실제 값으로 채운다.
# .env는 .gitignore로 제외된다 — 실제 비밀번호를 이 파일에 적지 말 것.
#
# Docker로 띄우면(docker compose up) 아래 4개만 채우면 된다. 나머지는 기본값으로 동작한다.
#   POSTGRES_PASSWORD, DJANGO_SECRET_KEY  — 무작위 값. 둘 다 같은 한 줄로 만든다:
#       python -c "import secrets; print(secrets.token_urlsafe(50))"
#     (Python이 없으면: docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_urlsafe(50))")
#   DJANGO_SUPERUSER_EMAIL, DJANGO_SUPERUSER_PASSWORD — 첫 로그인에 쓸 관리자 계정
# 기본값을 두지 않는 이유: 없으면 예측 가능한 값으로 조용히 뜨는 대신 즉시 실패(fail-fast)한다.
# 값에 $를 넣지 말 것 — docker compose가 ${...} 변수로 해석해 조용히 지운다. 위 명령(token_urlsafe)은 $를 만들지 않는다.

POSTGRES_DB=sast
POSTGRES_USER=sast
# 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
POSTGRES_PASSWORD=change-me-generate-a-random-value
POSTGRES_PORT=5432
# Django가 접속할 DB 호스트 — 호스트 개발용. 컨테이너(web·worker)는 compose가 db로 덮어쓴다
POSTGRES_HOST=127.0.0.1

# Django 설정
# SECRET_KEY는 반드시 새로 생성한다. 기본값 없이 없으면 기동 실패(fail-fast)한다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-random-value
# 운영 기본값은 False. 로컬 개발에서만 True로 둔다.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 관리자 계정 (Docker 첫 기동에서 manage.py ensure_superuser가 만든다 — 이미 있으면 건너뜀)
# 이 시스템은 가입이 없어 관리자가 없으면 로그인이 불가능하다. 비밀번호는 Django 검증기(8자 이상,
# 흔한 값·숫자만 금지 등)를 통과해야 하며, placeholder를 그대로 두면 기동이 멈춘다.
# 호스트 개발에서는 비워 두고 `manage.py createsuperuser`를 써도 된다.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password
# 컨테이너 web 포트 (호스트 runserver 8000과 같이 띄우려면 바꾼다)
WEB_PORT=8000

# 분석 상한 (SEC-008, zip bomb 방어) — 원본 zip MB / 압축 해제 총합 MB / 파일 개수
ANALYSIS_MAX_UPLOAD_MB=200
ANALYSIS_MAX_EXTRACTED_MB=500
ANALYSIS_MAX_EXTRACTED_FILES=20000
# Semgrep 실행 타임아웃(초, SEC-009). 초과 시 실행은 FAILED로 기록된다.
ANALYSIS_SEMGREP_TIMEOUT=600
# 자체 taint 엔진 — Semgrep 뒤에 같은 워커 작업에서 도는 Python 흐름 추적. 끄면 Semgrep 결과만 표준화
ANALYSIS_CUSTOM_TAINT_ENABLED=True
# 자체 taint 엔진 시간 예산(초). 넘기면 남은 파일을 건너뛰고 통계에 기록
ANALYSIS_CUSTOM_TAINT_TIMEOUT=120
# 분석 실행 큐 백엔드 — database(기본, 워커 `manage.py analysis_worker` 필요) / immediate(요청 안에서 동기 실행)
ANALYSIS_TASK_BACKEND=database
# RUNNING 고착 판정 여유(초). 워커가 죽어 RUNNING에 남은 실행은 타임아웃+여유 뒤 워커 시작 시 FAILED로 정리
ANALYSIS_STALE_RUN_GRACE=300
